# frozen_string_literal: true
require 'securerandom'

# Debian 13 (Trixie) — locally built VirtualBox base box.

provider = ENV.fetch('IOT_VAGRANT_PROVIDER', 'virtualbox')
raise "Unsupported provider: #{provider}" unless provider == 'virtualbox'

# Generated *on the Linux VM hosting Vagrant*, before either guest starts.
# Both server and worker receive it in Vagrant's synchronized /vagrant folder.
token_file = File.expand_path('.iot-join-token', __dir__)
unless File.exist?(token_file)
  File.write(token_file, SecureRandom.hex(48) + "\n")
end
File.chmod(0o600, token_file)

Vagrant.configure('2') do |config|
  config.vm.box = 'IoT-Debian13-virtualbox'
  # explicitly required in the subject:
  config.vm.box_url = "file://#{File.expand_path('../boxes/IoT-Debian13.8-virtualbox.box', __dir__)}"
  config.vm.box_check_update = false # Use the installed local box
  config.vm.synced_folder '.', '/vagrant', type: 'rsync'

  # Provider-specific limits (required by the exercise for Part 1).
  { 'hlehmannS' => ['192.168.56.110', 'IoT-server.sh'],
    'hlehmannSW' => ['192.168.56.111', 'IoT-worker.sh'] }.each do |machine_name, (ip, script)|
    config.vm.define machine_name do |node|
      # K3s's current published server minimum is 2 CPU / 2 GiB RAM.
      # The subject's 1 CPU / 1 GiB advice is explicitly not mandatory.
      tiny = ENV['IOT_P1_TINY'] == '1'
      cpus = (machine_name == 'hlehmannS' && !tiny) ? 2 : 1
      memory = (machine_name == 'hlehmannS' && !tiny) ? 2048 : 1024
      node.vm.hostname = machine_name
      node.vm.network 'private_network', ip: ip
      node.vm.provider 'virtualbox' do |vb|
        vb.name = machine_name
        vb.cpus = cpus
        vb.memory = memory
      end
      node.vm.provision 'shell', path: "scripts/#{script}"
    end
  end
end
