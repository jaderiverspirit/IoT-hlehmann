# frozen_string_literal: true

# Debian 13 (Trixie) — locally built VirtualBox base box.

provider = ENV.fetch('IOT_VAGRANT_PROVIDER', 'virtualbox')
raise "Unsupported provider: #{provider}" unless provider == 'virtualbox'

Vagrant.configure('2') do |config|
  config.vm.boot_timeout = 900
  config.vm.box = 'IoT-Debian13-virtualbox'
  # explicitly required in the subject:
  config.vm.box_url = "file://#{File.expand_path('../boxes/IoT-Debian13.8-virtualbox.box', __dir__)}"
  config.vm.box_check_update = false
  config.vm.synced_folder '.', '/vagrant', type: 'rsync'

  config.vm.define 'hlehmannS' do |server|
    server.vm.hostname = 'hlehmannS'
    server.vm.network 'private_network', ip: '192.168.56.110'

    server.vm.provider 'virtualbox' do |vb|
      vb.name = 'hlehmannS'
      vb.cpus = 2
      vb.memory = 2048
    end

    server.vm.provision 'shell', path: 'scripts/IoT-install.sh'
  end
end
